PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret

# Set either DATABASE_URL or the individual PG* variables below.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vart_db
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=vart_db
# PGUSER=postgres
# PGPASSWORD=your_password
# PGSSL=false

# Fill these in after creating your Google OAuth Web Client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Set the merchant PromptPay ID (10-digit mobile, 13-digit national/tax ID, or 15-digit e-wallet ID).
# This value is used only by the API to generate an order-specific QR with the exact order total.
PROMPTPAY_ID=
